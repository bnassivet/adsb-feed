# Copy to .env and adjust. All settings are optional — the defaults below are
# what the service uses if you set nothing.

# --- Service ---
ADSB_SIM_AGENT_PORT=8300
ADSB_SIM_AGENT_HOST=0.0.0.0

# --- LLM (route-hint classification only; optional) ---
# Points at LM Studio by default. If unreachable, route hints are ignored and
# seeded default plans are used instead — the service still works.
ADSB_SIM_AGENT_LLM_BASE_URL=http://localhost:1234/v1
ADSB_SIM_AGENT_LLM_API_KEY=lm-studio
ADSB_SIM_AGENT_MODEL=qwen2.5-7b-instruct
ADSB_SIM_AGENT_TEMPERATURE=0.0
# Reasoning models spend hundreds of tokens thinking before emitting content,
# and vague hints cost far more than specific ones. Too low and the model
# returns an empty string, silently degrading to default route plans.
ADSB_SIM_AGENT_MAX_TOKENS=2048
ADSB_SIM_AGENT_LLM_TIMEOUT_S=30

# Which classification prompt to send: full (default) or compact.
# Prompt tokens and answer tokens share the MAX_TOKENS budget above, so on a
# small or reasoning-heavy model the full prompt can leave no room to reply --
# the answer comes back empty with finish_reason='length'. The compact prompt is
# 45% the size, same schema, no teaching.
#ADSB_SIM_AGENT_PROMPT_STYLE=compact

# Reasoning budget, for models that think before answering. Reasoning tokens are
# charged against MAX_TOKENS, so an eager model can spend the whole budget and
# return nothing. Both are sent only when set, and both are a *request*: support
# varies by provider and an endpoint that doesn't understand them ignores them.
# Many local models treat this as a TOGGLE, not a dial: only "none" has any
# effect. Measured on gemma-4-12b-qat with the compact prompt: 4s / 162 tokens
# with reasoning off vs 23s / 1083 with it on, same answer. off|false|no|
# disabled|none all reach the working value; on|true|yes send nothing.
#ADSB_SIM_AGENT_REASONING_EFFORT=none         # none/off | minimal | low | medium | high
#ADSB_SIM_AGENT_REASONING_MAX_TOKENS=256      # only for providers that cap reasoning

# NOTE: the caller must outlast the callee, or a slow classification surfaces as
# "could not reach the simulation agent" while it is up and working. The callee's
# worst case is 2 x LLM_TIMEOUT_S (one classification plus the truncation retry),
# so ADSB_AGENT_SIMULATION_AGENT_TIMEOUT in adsb-agent/.env must exceed that.
# Working local example with reasoning off: LLM_TIMEOUT_S=45 here, caller 120.

# --- Generation ---
# Regeneration attempts after a failed plausibility check.
ADSB_SIM_AGENT_MAX_RETRIES=2

# --- MLflow tracing ---
# The experiment must match adsb-agent's, or the two services' spans cannot
# share a trace: a trace lives in exactly one experiment.
ADSB_SIM_AGENT_MLFLOW_ENABLED=true
ADSB_SIM_AGENT_MLFLOW_TRACKING_URI=http://localhost:5010
ADSB_SIM_AGENT_MLFLOW_EXPERIMENT=adsb-agent

# MinIO artifact store — required when MLflow uses S3-compatible storage, and
# must match adsb-agent/.env. Without them boto3 tries to reach real AWS S3 and
# trace export fails.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

MLFLOW_DISABLE_TELEMETRY=true
