[Unit]
Description=ADS-B Feed Client (dump1090 -> MQTT/Pulsar)
Documentation=file:///usr/local/share/doc/adsb/README.md
After=network-online.target
Wants=network-online.target
# dump1090 is the data source; start after it when co-located.
After=dump1090-fa.service
# MQTT here is QoS 0 with persistence off, so anything published before the
# recorder has subscribed is lost. Ordering only -- a recorder that fails to
# start must NOT stop the feed, which may still have a Pulsar leg and in any
# case should keep running when storage is broken. Ignored on 32-bit nodes,
# where adsb-data-server is not installed.
After=adsb-data-server.service

[Service]
Type=simple
User=adsb
Group=adsb
DynamicUser=no

# All settings come from the config file. Every flag also has an env var
# (ADSB_SOURCE_ID, ADSB_MQTT_BROKER, ...), so EnvironmentFile can override
# individual values without editing the TOML.
EnvironmentFile=-/etc/adsb/feed.env
ExecStart=/usr/local/bin/adsb-pulsar-client --config /etc/adsb/feed.toml

Restart=always
RestartSec=10

# This process only parses lines and forwards bytes -- it holds no database and
# no large buffers, so 100M is generous. Do NOT copy this limit to
# adsb-data-server: DuckDB wants >=125 MB per thread and will be OOM-killed.
MemoryMax=100M
CPUQuota=50%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Needed only by the file forwarder; harmless otherwise.
ReadWritePaths=/var/lib/adsb

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adsb-feed

[Install]
WantedBy=multi-user.target
