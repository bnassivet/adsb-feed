# Frontend settings for the desktop app.
#
#   cp .env.local.template .env.local     # .env.local is git-ignored
#
# Next.js inlines NEXT_PUBLIC_* values when it compiles (`next dev` startup or
# `next build`), so restart the app after editing this file.
#
# Precedence: a variable already set in the environment beats this file.
# `make up-desktop` / `make client` set these from adsb-stack.toml:
# NEXT_PUBLIC_AGENT_URL always, NEXT_PUBLIC_CARTO_API_KEY when the key is set,
# and NEXT_PUBLIC_COPILOTKIT_DISABLE_INSPECTOR when the inspector is turned off.
# A value the stack sets wins over this file; `make desktop-env` shows what it
# passes (except the CARTO key). Without the stack (`npm run tauri dev`), this
# file decides.
#
# Only the frontend reads this file. The Tauri (Rust) side takes its ADSB_*
# variables from the environment, not from here.

# Base URL of the AI agent (AG-UI runtime at <url>/ag-ui).
# Default: http://localhost:8000. Stack: [agents] agent_port.
# A different port must also be allowed by the CSP in src-tauri/tauri.conf.json
# (connect-src), or the request is blocked; `make up-desktop` handles that.
# NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# CARTO basemap key. Since 2026-09-25 CARTO raster tiles need one; without it
# the map uses Esri tiles. Free at carto.com/basemaps/apikey.
# Default: unset. Stack: [desktop] carto_api_key.
# NEXT_PUBLIC_CARTO_API_KEY=

# Turn off CopilotKit's developer inspector (true / 1 / yes).
# It only exists in dev builds on localhost, and it is the app's only
# third-party traffic there: news feeds from cdn.copilotkit.ai, Google Fonts,
# and promo videos. A release build never has it.
# Default: unset, meaning the inspector is available.
# Stack: [desktop] copilotkit_inspector = false sets this to true. At its
# default (true) the stack leaves it unset, so this line still applies.
# NEXT_PUBLIC_COPILOTKIT_DISABLE_INSPECTOR=true
