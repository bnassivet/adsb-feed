# Copy to .env and adjust values for your environment.
# All vars use the ADSB_AGENT_ prefix.

# MLflow tracing — start server with: mlflow server --port 5010
ADSB_AGENT_MLFLOW_ENABLED=true
ADSB_AGENT_MLFLOW_TRACKING_URI=http://localhost:5010
ADSB_AGENT_MLFLOW_EXPERIMENT=adsb-agent

# MinIO artifact store — required when MLflow uses S3-compatible storage (MinIO).
# Without these, boto3 tries to reach real AWS S3 and fails with NoCredentialsError.
# Match these values to your docker-compose MinIO service credentials.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# LLM endpoint (LM Studio, Ollama, OpenAI, etc.)
ADSB_AGENT_LLM_BASE_URL=http://localhost:1234/v1
ADSB_AGENT_LLM_API_KEY=lm-studio
# A capable tool-calling model is REQUIRED for the multi-hop ReAct loop. The old
# 1.2B model cannot plan/chain tool calls. Pull e.g. Qwen2.5-7B-Instruct (or 14B
# if you have the RAM) in LM Studio/Ollama. Use the small model only on
# resource-constrained devices, expecting weak reasoning.
ADSB_AGENT_MODEL=qwen2.5-7b-instruct
#ADSB_AGENT_MODEL=qwen2.5-14b-instruct
#ADSB_AGENT_MODEL=liquidai/lfm2.5-1.2b-instruct-mlx  # tiny fallback, weak reasoning

# Tauri tool server (read-only DuckDB data plane the agent chains internally).
# Must match the desktop app's ADSB_AGENT_TOOL_SERVER_PORT (default 8787).
ADSB_AGENT_TOOL_SERVER_URL=http://127.0.0.1:8787

# Agent server
ADSB_AGENT_PORT=8000
ADSB_AGENT_HOST=0.0.0.0

# Telemetry and tracking opt-out (for MLflow and any other tools respecting these vars)
MLFLOW_DISABLE_TELEMETRY=true
DO_NOT_TRACK=true

# --- Tool ranking (experimental, off by default) ---
# Before each LLM call, a small decision model scores every tool against the
# request and only the best are bound: tool schemas were ~3/4 of every prompt.
# Any failure falls back to the full tool list. Evaluate before enabling: eval/.
#ADSB_AGENT_TOOL_RANKER_ENABLED=true
#ADSB_AGENT_TOOL_RANKER_URL=http://localhost:5010/gateway/typesafe/v1/systemone
#ADSB_AGENT_TOOL_RANKER_MODEL=d1-omni-600m
#ADSB_AGENT_TOOL_RANKER_TOP_K=10
#ADSB_AGENT_TOOL_RANKER_PINNED=["getCurrentDateTime"]

# Where the ambient UI state goes in the prompt: "user" (default, on the latest
# user message; keeps the system prompt and tool schemas cacheable by the model
# server) or "system" (original layout; any UI-state change reprocesses the
# whole prompt, ~17 s on gemma-4-12b-qat).
# ADSB_AGENT_CONTEXT_PLACEMENT=user

# --- Desktop fast path (ON by default) ------------------------------------
# A direct display command ("switch to night mode", "hide the labels") is
# carried out by a small model BEFORE the main agent: ~0.3 s instead of several
# seconds, same correctness (eval/fastpath_agent/FAST_PATH_EXPERIMENT.md). A request
# passes four checks in order; any "no", timeout or error sends it to the main
# agent exactly as without the fast path:
#   0. question form  - does not start with a question word, end with "?" or
#                       open with a negation (no model call)
#   1. embedding gate - closer to a display tool than to any other tool
#   2. veto           - the decision model calls it a display command
#   3. executor       - the small model makes a schema-valid tool call
# It needs three models reachable: the executor (FAST_PATH_MODEL), the embedding
# model (FAST_PATH_EMBED_MODEL) and the decision model (TOOL_RANKER_MODEL).
#
# Turn the whole fast path OFF: every request goes to the main agent.
#ADSB_AGENT_FAST_PATH_ENABLED=false
#
# Turn only the QUESTION-FORM check off. Questions about what a display tool
# controls ("is the sidebar open?") then reach the gate, which matches by topic
# and lets some through: 10 wrong actions in 95 fresh agent requests without
# the check, 3 with it (veto off in both).
#ADSB_AGENT_FAST_PATH_QUESTION_CHECK_ENABLED=false
#
# Turn only the VETO off. Faster by ~0.1 s on requests that pass the gate and
# handles about 6 more commands in 60, but requests that merely resemble a
# command ("pan to the selected aircraft") then reach the small model: measured
# 4 wrong actions in 273 requests against 0 with the veto on.
#ADSB_AGENT_FAST_PATH_VETO_ENABLED=false
# The veto drops a request when P(display command) is under this (0..1).
#ADSB_AGENT_FAST_PATH_VETO_BELOW=0.5
#
# Gate threshold: minimum embedding margin. Tied to the embedding model and the
# packaged descriptions (src/adsb_agent/fast_path_descriptions.json). After
# changing either, refit:  uv run python eval/fastpath_agent/eval_fast_path_service.py --fit
#ADSB_AGENT_FAST_PATH_EMBED_THRESHOLD=0.0605
#
# Executor (OpenAI-compatible server). REASONING_EFFORT empty = do not send it.
#ADSB_AGENT_FAST_PATH_MODEL=mistralai/ministral-3-3b
#ADSB_AGENT_FAST_PATH_BASE_URL=http://localhost:1234/v1
#ADSB_AGENT_FAST_PATH_API_KEY=lm-studio
#ADSB_AGENT_FAST_PATH_REASONING_EFFORT=none
# Gate embeddings (OpenAI-compatible /embeddings).
#ADSB_AGENT_FAST_PATH_EMBED_URL=http://localhost:5010/gateway/openai/v1/embeddings
#ADSB_AGENT_FAST_PATH_EMBED_MODEL=lmstudio-embeddinggemma-300m
# Seconds before a stage gives up and the main agent takes the request. When a
# model is not loaded, every request waits this long first.
#ADSB_AGENT_FAST_PATH_GATE_TIMEOUT=2.0
#ADSB_AGENT_FAST_PATH_EXECUTOR_TIMEOUT=5.0
# Reply sent after a fast-path action (no model call).
#ADSB_AGENT_FAST_PATH_CONFIRMATION=Done.
