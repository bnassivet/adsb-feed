# langgraph dev / langgraph-cli local runtime state
.langgraph_api/

# Local environment + virtualenv
.env
.venv/

# Downloaded voice models (LFM2.5-Audio GGUFs, ~10 GB) — see install_lfm-25-audio-server.sh
models/

# Defense-in-depth: never version large model weights / binaries, wherever they land
*.gguf
*.bin
*.safetensors

# Local MLflow stores, should a script run without MLFLOW_TRACKING_URI set
mlflow.db
mlruns/

# Evaluation harness: cached decision-model scores
eval/.cache/
# Raw mining output: regenerable, and verbatim chat text that has not been reviewed
eval/data/candidates.jsonl
eval/results/
